{
  "name": "secondvoice",
  "version": "0.1.0",
  "description": "An in-app assistant that interrupts scam payments, and the test harness that pits it against coached victims.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
